// Build the original Worker with one explicit public instance roster first:
// npm run build -- --roster /instance/public-roster.json --out dist/worker.mjs
// Source instance data is an immutable bundle input, not a large environment variable.
// The same artifact may be served by the existing authorized cloud deployment writer.
{
  "name": "assist-561-group",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "routes": [
    { "pattern": "assist.561.group/*", "zone_name": "561.group" },
    { "pattern": "*.assist.561.group/*", "zone_name": "561.group" }
  ]
}
